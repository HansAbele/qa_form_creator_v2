{
  "name": "qore",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "node scripts/guard-db-push.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit --pretty false --incremental false",
    "test": "vitest --passWithNoTests --environment=node --exclude=**/node_modules/** --exclude=**/.next/** --exclude=**/.claude/** --exclude=**/.codex-runtime/** --exclude=**/tests/e2e/** --exclude=**/playwright-report/** --exclude=**/test-results/**",
    "test:ci": "vitest run --passWithNoTests --environment=node --exclude=**/node_modules/** --exclude=**/.next/** --exclude=**/.claude/** --exclude=**/.codex-runtime/** --exclude=**/tests/e2e/** --exclude=**/playwright-report/** --exclude=**/test-results/**",
    "test:integration:response-concurrency": "vitest run tests/integration/response-concurrency.test.ts --environment=node",
    "test:integration:form-publication-concurrency": "vitest run tests/integration/form-publication-concurrency.test.ts --environment=node",
    "test:integration:export-admission": "vitest run tests/integration/export-admission-concurrency.test.ts --environment=node",
    "test:integration:export-download": "vitest run tests/integration/export-download.test.ts --environment=node",
    "test:e2e": "playwright test",
    "benchmark:analytics": "tsx scripts/benchmark-analytics.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.97",
    "@ai-sdk/openai": "^3.0.85",
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.228",
    "archiver": "5.3.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.4.10",
    "@next/env": "16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/archiver": "5.3.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
