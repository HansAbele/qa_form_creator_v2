# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright/.auth/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.*.log
.logs/
.pnpm-store/

# local Codex/Claude worktrees and generated workspace state
.claude/worktrees/

# env files - never commit secrets or machine-local credentials
.env
.env.local
.env.production
.backup-key
.qore-operations.lock
.deployed-release
/backups/
odoo.local.env
*.local.env
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts committed intentionally (needed for TS in new machine)

# deploy temp dirs
/_local_save/
/_server_backup/

# generated one-off migration/reset artifacts
/scripts/migration.sql
/scripts/pw.sql
