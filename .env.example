# ─── Base de datos ────────────────────
DATABASE_URL=postgresql://qa_app:CHANGE_ME_DB_PASSWORD@localhost:5432/qa_form_creator

# ─── Auth.js ──────────────────────────
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
RATE_LIMIT_HASH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── IA (opcional) ────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=

# ─── App ──────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
# Zona IANA usada por rangos, agrupaciones y etiquetas de fecha.
OPERATIONAL_TIME_ZONE=UTC
# Directorio privado fuera de public/. En Docker se usa /var/lib/qore/recordings.
RECORDING_STORAGE_ROOT=storage/recordings
MAX_RECORDING_BYTES=262144000
# NICE CXone usa Access Keys de servicio; no coloque aqui passwords personales.
NICE_CXONE_TOKEN_URL=
NICE_CXONE_ACCESS_KEY_ID=
NICE_CXONE_ACCESS_KEY_SECRET=
NICE_CXONE_API_BASE_URL=
# HAPUSA usa ACD legacy; Media Playback solo se requiere para el modo alternativo.
NICE_CXONE_RECORDING_MODE=legacy-acd
NICE_CXONE_ADMIN_API_VERSION=v34.0
NICE_CXONE_MEDIA_BASE_URL=
NICE_CXONE_INSTANCE_KEY=hapusa
NICE_CXONE_SCOPE_FIELD=campaign
NICE_CXONE_PAGE_SIZE=1000
NICE_CXONE_MAX_LEGACY_RECORDING_BYTES=104857600
# Transcripción server-side. Nunca use el prefijo NEXT_PUBLIC_ para estas claves.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEY_II=
NVIDIA_NIM_TRANSCRIPTION_URL=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com/v1/audio/transcriptions
NVIDIA_NIM_TRANSCRIPTION_MODEL=parakeet-ctc-1.1b-asr
GROQ_API_KEY=
GROQ_API_KEY_II=
GROQ_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Deepgram es el proveedor administrado de diarización para audio mono.
DEEPGRAM_API_KEY=
DEEPGRAM_API_KEY_II=
DEEPGRAM_TRANSCRIPTION_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
TRANSCRIPTION_PROVIDER_ORDER=DEEPGRAM,NVIDIA_NIM,GROQ
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_REQUEST_TIMEOUT_MS=300000
TRANSCRIPTION_MAX_AUDIO_BYTES=25165824
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCRIPTION_WORKER_ENABLED=true
TRANSCRIPTION_WORKER_POLL_MS=5000
TRANSCRIPTION_JOB_MAX_ATTEMPTS=3
TRANSCRIPTION_JOB_LEASE_MS=2700000
# Limites de seguridad para descargas; consulta el runbook antes de elevarlos.
EXPORT_MAX_EVALUATIONS=1000
EXPORT_MAX_ANSWER_ROWS=10000
EXPORT_MAX_QUESTION_COLUMNS=100
EXPORT_MAX_CELLS=100000
EXPORT_MAX_TEXT_BYTES=8000000
EXPORT_MAX_REQUESTS_PER_MINUTE=4
EXPORT_MAX_CONCURRENT_PER_USER=1
EXPORT_MAX_CONCURRENT_GLOBAL=2
EXPORT_LEASE_TIMEOUT_SECONDS=900
# El webhook es opcional en desarrollo. Produccion exige HTTPS y token fuerte.
OBSERVABILITY_SERVICE_NAME=qore-local
ERROR_REPORTING_WEBHOOK_URL=
ERROR_REPORTING_WEBHOOK_TOKEN=

# ─── Herramientas locales de datos (solo cuando se ejecuten) ───
# El seed de muestra solo acepta una base local y se bloquea en produccion.
QORE_SEED_ADMIN_PASSWORD=
QORE_SEED_QA_PASSWORD=
QORE_SEED_QA_ELEVATED_PASSWORD=
QORE_SEED_SUPERVISOR_PASSWORD=

# E2E acepta las credenciales QORE_SEED_* equivalentes como fallback.
E2E_ADMIN_PASSWORD=
E2E_QA_PASSWORD=
E2E_QA_ELEVATED_PASSWORD=
E2E_SUPERVISOR_PASSWORD=

# Los importadores crean cuentas sin password; un ADMIN asigna credenciales
# individuales despues. La promocion ADMIN requiere un opt-in separado.
QORE_ALLOW_REMOTE_IMPORT=false
QORE_ALLOW_PRODUCTION_IMPORT=false
QORE_ALLOW_ADMIN_IMPORT=false
ODOO_DB_PASSWORD=
QORE_SSH_PASSWORD=
QORE_DB_USER=qa_user
QORE_DB_NAME=qa_form_creator

# Requiere una confirmacion separada para --accept-data-loss/--force-reset.
ALLOW_PRISMA_DB_PUSH_DATA_LOSS=false
