generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum Role {
  ADMIN
  QA
  SUPERVISOR
  AGENT
}

enum CampaignAccessLevel {
  CAMPAIGN_ADMIN
  EVALUATOR
  SUPERVISOR
  AGENT
}

enum QuestionType {
  TEXT
  RATING
  SELECT
  RADIO
  BOOLEAN
}

// COPC critical-error classification (2.7.1.d). A question flagged `fatal`
// may carry one of these so failures roll up into per-class critical accuracy.
enum CriticalType {
  CUSTOMER
  BUSINESS
  COMPLIANCE
}

// Machine-readable call outcome, so KPIs (FCR, escalation rate) stop relying
// on disposition name-matching. One outcome per call.
enum DispositionOutcome {
  RESOLVED
  ESCALATED
  TRANSFERRED
  FOLLOW_UP
  CALLBACK
  SALE
  NO_SALE
  NO_CONTACT
  DNC
  SYSTEM
  OTHER
}

enum InteractionProvider {
  NICE_CXONE
  VICIDIAL
  FREEPBX
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  UNKNOWN
}

enum MediaAssetKind {
  ORIGINAL
  PLAYBACK
}

enum TranscriptProvider {
  NICE_CXONE
  NVIDIA_NIM
  GROQ
  DEEPGRAM
  OPENAI
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SPEAKERS_UNVERIFIED
}

enum TranscriptionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpeakerRole {
  AGENT
  CUSTOMER
  UNKNOWN
}

enum QaActivityType {
  EVALUATION
  COACHING_PREPARATION
  COACHING_LIVE
  COACHING_DOCUMENTATION
  CALIBRATION
  DISPUTE_REVIEW
  TRAINING
  MEETING
  ADMINISTRATIVE
  SYSTEM_ISSUE
  OTHER
}

enum QaActivityStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CoachingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AWAITING_ACKNOWLEDGEMENT
  COMPLETED
  CANCELLED
}

enum CoachingSource {
  MANUAL
  EVALUATION
  TREND
  CRITICAL_FAILURE
  CALIBRATION
  PIP_REVIEW
  OTHER
}

enum AcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  REFUSED
}

enum AcknowledgementMethod {
  IN_PERSON
  SECURE_LINK
  EMAIL
  COMPANY_SYSTEM
  WITNESSED
}

enum CoachingActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PerformanceEvidenceType {
  EVALUATION
  CALL_RECORDING
  TRANSCRIPT_EXCERPT
  METRIC
  DOCUMENT
  NOTE
}

enum PipStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  EXTENDED
  COMPLETED_SUCCESSFULLY
  COMPLETED_UNSUCCESSFULLY
  CANCELLED
}

enum PipGoalStatus {
  PENDING
  ON_TRACK
  AT_RISK
  MET
  NOT_MET
  NOT_APPLICABLE
}

enum PipReviewOutcome {
  ON_TRACK
  AT_RISK
  IMPROVED
  NO_PROGRESS
}

// ─── Auth.js required models ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Usuarios y campañas ─────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  password             String?
  role                 Role      @default(QA)
  active               Boolean   @default(true)
  sessionVersion       Int       @default(0)
  mustChangePassword   Boolean   @default(false)
  locale               String    @default("en")
  workspacePreferences Json?
  image                String?
  emailVerified        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts                          Account[]
  sessions                          Session[]
  campaigns                         UserCampaign[]
  forms                             Form[]                    @relation("FormCreator")
  responses                         Response[]                @relation("Evaluator")
  dispositionsCreated               Disposition[]             @relation("DispositionCreator")
  auditLogs                         AuditLog[]                @relation("AuditActor")
  coachingSessionsCoached           CoachingSession[]         @relation("CoachingCoach")
  coachingSessionsCreated           CoachingSession[]         @relation("CoachingCreator")
  coachingAcknowledgementsWitnessed CoachingAcknowledgement[] @relation("CoachingAcknowledgementWitness")
  qaActivitySessions                QaActivitySession[]
  pipPlansOwned                     PipPlan[]                 @relation("PipOwner")
  pipPlansCreated                   PipPlan[]                 @relation("PipCreator")
  pipPlansApproved                  PipPlan[]                 @relation("PipApprover")
  pipPlansWitnessed                 PipPlan[]                 @relation("PipAcknowledgementWitness")
  pipReviews                        PipReview[]               @relation("PipReviewer")
  agentProfile                      Agent?                    @relation("AgentPortalAccount")
  performanceEvidenceCreated        PerformanceEvidence[]     @relation("PerformanceEvidenceCreator")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 UserCampaign[]
  forms                 Form[]
  agents                Agent[]
  teams                 Team[]
  dispositionCategories DispositionCategory[]
  dispositions          Disposition[]
  auditLogs             AuditLog[]
  scoringSettings       CampaignScoringSettings?
  callSources           CampaignCallSource[]
  interactions          Interaction[]
  coachingSessions      CoachingSession[]
  qaActivitySessions    QaActivitySession[]
  pipPlans              PipPlan[]
  performanceEvidence   PerformanceEvidence[]
}

model UserCampaign {
  userId                   String
  campaignId               String
  assignedAt               DateTime            @default(now())
  roleInCampaign           CampaignAccessLevel @default(EVALUATOR)
  canViewDashboard         Boolean             @default(true)
  canViewKPIs              Boolean             @default(false)
  canViewForms             Boolean             @default(true)
  canViewEvaluations       Boolean             @default(false)
  canCreateForms           Boolean             @default(false)
  canEditForms             Boolean             @default(false)
  canPublishForms          Boolean             @default(false)
  canEvaluate              Boolean             @default(true)
  canEditEvaluations       Boolean             @default(false)
  canViewReports           Boolean             @default(false)
  canExport                Boolean             @default(false)
  canManageAgents          Boolean             @default(false)
  canManageDispositions    Boolean             @default(false)
  canManageCampaignScoring Boolean             @default(false)
  canViewAudit             Boolean             @default(false)
  canViewCoaching          Boolean             @default(true)
  canManageCoaching        Boolean             @default(false)
  canTrackQaActivity       Boolean             @default(false)
  canViewQaActivity        Boolean             @default(false)
  canViewPips              Boolean             @default(false)
  canManagePips            Boolean             @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([userId, campaignId])
  @@index([campaignId])
}

// ─── Equipos ─────────────────────────────────────────

model Team {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agents   Agent[]

  @@unique([name, campaignId])
}

// ─── Disposiciones ───────────────────────────────────

model DispositionCategory {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dispositions Disposition[]

  @@unique([name, campaignId])
}

model Disposition {
  id          String              @id @default(cuid())
  name        String
  code        String?
  categoryId  String?
  campaignId  String
  active      Boolean             @default(true)
  outcomeType DispositionOutcome?
  isSystem    Boolean             @default(false)
  createdById String?
  createdAt   DateTime            @default(now())

  category     DispositionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("DispositionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responses    Response[]
  interactions Interaction[]

  @@unique([name, campaignId])
  @@index([campaignId, active])
}

// ─── Agentes (no inician sesión) ─────────────────────

model Agent {
  id         String   @id @default(cuid())
  name       String
  agentCode  String?
  campaignId String
  teamId     String?
  userId     String?  @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user             User?             @relation("AgentPortalAccount", fields: [userId], references: [id], onDelete: SetNull)
  responses        Response[]
  interactions     Interaction[]
  coachingSessions CoachingSession[]
  pipPlans         PipPlan[]

  @@unique([agentCode, campaignId])
  @@index([userId])
}

// ─── Formularios ─────────────────────────────────────

model Form {
  id                    String    @id @default(cuid())
  title                 String
  description           String?
  campaignId            String
  createdById           String
  parentFormId          String?
  status                String    @default("DRAFT")
  version               String    @default("1.0.0")
  templateKey           String?
  templateVersion       String?
  passThresholdOverride Int?
  gradingScale          Json?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  campaign   Campaign       @relation(fields: [campaignId], references: [id])
  createdBy  User           @relation("FormCreator", fields: [createdById], references: [id])
  parent     Form?          @relation("FormRevisions", fields: [parentFormId], references: [id], onDelete: SetNull)
  revisions  Form[]         @relation("FormRevisions")
  categories FormCategory[]
  questions  Question[]
  responses  Response[]

  @@index([parentFormId])
  @@index([status])
  @@index([templateKey])
}

model Question {
  id                    String        @id @default(cuid())
  formId                String
  formCategoryId        String?
  type                  QuestionType
  label                 String
  options               Json?
  required              Boolean       @default(false)
  weight                Int           @default(0)
  fatal                 Boolean       @default(false)
  fatalOptions          Json?
  criticalType          CriticalType?
  // For a `fatal` RATING: fails when value < ratingFailThreshold. Null → default (3, i.e. <=2 on 1-5).
  ratingFailThreshold   Int?
  // Configurable rating scale. ratingMax null → 5; ratingStyle null → "numeric" (vs "stars").
  ratingMax             Int?
  ratingStyle           String?
  requiresCommentOnFail Boolean       @default(false)
  order                 Int           @default(0)

  form         Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  formCategory FormCategory? @relation(fields: [formCategoryId], references: [id], onDelete: SetNull)
  answers      Answer[]

  @@index([formId, order])
  @@index([formCategoryId])
}

model QACategory {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  systemColor           String?
  systemIcon            String?
  isActive              Boolean  @default(true)
  canBeFatal            Boolean  @default(false)
  requiresCommentOnFail Boolean  @default(false)
  visibleInDashboard    Boolean  @default(true)
  visibleInKPIs         Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  formCategories FormCategory[]
  answers        Answer[]
}

model FormCategory {
  id              String  @id @default(cuid())
  formId          String
  qaCategoryId    String
  weight          Int     @default(0)
  fatalIfFailed   Boolean @default(false)
  requiresComment Boolean @default(false)
  sortOrder       Int     @default(0)

  form       Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  qaCategory QACategory @relation(fields: [qaCategoryId], references: [id], onDelete: Restrict)
  questions  Question[]

  @@unique([formId, qaCategoryId])
  @@index([qaCategoryId])
  @@index([formId, sortOrder])
}

// ─── Evaluaciones ────────────────────────────────────

model Response {
  id                 String    @id @default(cuid())
  formId             String
  formVersion        String?
  agentId            String
  evaluatorId        String
  dispositionId      String?
  score              Decimal   @db.Decimal(5, 2)
  result             String?
  hasFatalFail       Boolean   @default(false)
  status             String    @default("DRAFT")
  scoringSnapshot    Json?
  settingsSnapshot   Json?
  formSnapshot       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  submittedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  interactionId      String?   @unique

  form                Form                  @relation(fields: [formId], references: [id])
  agent               Agent                 @relation(fields: [agentId], references: [id])
  evaluator           User                  @relation("Evaluator", fields: [evaluatorId], references: [id])
  disposition         Disposition?          @relation(fields: [dispositionId], references: [id])
  interaction         Interaction?          @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  answers             Answer[]
  coachingSessions    CoachingSession[]
  qaActivitySessions  QaActivitySession[]
  performanceEvidence PerformanceEvidence[]

  @@index([formId, createdAt])
  @@index([agentId])
  @@index([evaluatorId])
  @@index([dispositionId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, submittedAt, id])
  @@index([agentId, status, submittedAt, id])
  @@index([evaluatorId, status, submittedAt, id])
  @@index([formId, status, submittedAt, id])
  @@index([dispositionId, status, submittedAt, id])
  @@index([cancelledById])
}

// ─── Call Finder ─────────────────────────────────────────────────────────────

model CampaignCallSource {
  id                  String              @id @default(cuid())
  campaignId          String
  provider            InteractionProvider
  instanceKey         String              @default("default")
  externalCampaignIds String[]            @default([])
  enabled             Boolean             @default(true)
  settings            Json?
  lastSyncedAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, provider, instanceKey])
  @@index([provider, instanceKey, enabled])
}

model Interaction {
  id                    String               @id @default(cuid())
  campaignId            String
  agentId               String?
  dispositionId         String?
  provider              InteractionProvider
  providerInstance      String               @default("default")
  providerInteractionId String
  providerAgentId       String?
  providerAgentName     String?
  providerCampaignId    String?
  direction             InteractionDirection @default(UNKNOWN)
  phoneNumber           String?
  queueName             String?
  status                String?
  startedAt             DateTime
  endedAt               DateTime?
  durationSeconds       Int                  @default(0)
  hasRecording          Boolean              @default(false)
  metadata              Json?
  lastSyncedAt          DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  campaign              Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agent                 Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  disposition           Disposition?           @relation(fields: [dispositionId], references: [id], onDelete: SetNull)
  response              Response?
  mediaAssets           MediaAsset[]
  transcripts           Transcript[]
  transcriptionAttempts TranscriptionAttempt[]
  transcriptionJobs     TranscriptionJob[]
  coachingSessions      CoachingSession[]
  performanceEvidence   PerformanceEvidence[]

  @@unique([provider, providerInstance, providerInteractionId])
  @@index([campaignId, startedAt])
  @@index([agentId, startedAt])
  @@index([providerAgentName])
  @@index([dispositionId, startedAt])
  @@index([phoneNumber])
}

model MediaAsset {
  id               String         @id @default(cuid())
  interactionId    String
  kind             MediaAssetKind @default(ORIGINAL)
  storageKey       String         @unique
  originalFileName String?
  mimeType         String
  byteSize         BigInt
  sha256           String         @db.VarChar(64)
  durationMs       Int?
  channelCount     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  interaction           Interaction            @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  transcripts           Transcript[]
  transcriptionAttempts TranscriptionAttempt[]
  transcriptionJobs     TranscriptionJob[]

  @@index([interactionId, kind])
  @@index([sha256])
}

model Transcript {
  id             String              @id @default(cuid())
  interactionId  String
  mediaAssetId   String?
  provider       TranscriptProvider
  model          String
  language       String?
  status         TranscriptionStatus @default(PENDING)
  jobFingerprint String              @db.VarChar(64)
  fullText       String?             @db.Text
  isDiarized     Boolean             @default(false)
  speakerCount   Int?
  errorCode      String?
  errorMessage   String?             @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  interaction Interaction            @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset?            @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  segments    TranscriptSegment[]
  attempts    TranscriptionAttempt[]
  jobs        TranscriptionJob[]

  @@unique([mediaAssetId, provider, model, jobFingerprint])
  @@index([interactionId, status, completedAt])
}

model TranscriptSegment {
  id           String      @id @default(cuid())
  transcriptId String
  ordinal      Int
  startMs      Int
  endMs        Int
  speakerKey   String?
  speakerRole  SpeakerRole @default(UNKNOWN)
  text         String      @db.Text
  confidence   Float?

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, ordinal])
  @@index([transcriptId, startMs])
}

model TranscriptionAttempt {
  id            String              @id @default(cuid())
  interactionId String
  mediaAssetId  String?
  transcriptId  String?
  provider      TranscriptProvider
  model         String
  status        TranscriptionStatus
  attemptNumber Int                 @default(1)
  errorCode     String?
  errorMessage  String?             @db.Text
  startedAt     DateTime            @default(now())
  completedAt   DateTime?

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  transcript  Transcript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)

  @@index([interactionId, startedAt])
  @@index([provider, status, startedAt])
}

model TranscriptionJob {
  id                 String                 @id @default(cuid())
  interactionId      String
  mediaAssetId       String
  transcriptId       String?
  requestedById      String?
  requireDiarization Boolean                @default(false)
  status             TranscriptionJobStatus @default(PENDING)
  attemptCount       Int                    @default(0)
  maxAttempts        Int                    @default(3)
  runAfter           DateTime               @default(now())
  lockedAt           DateTime?
  completedAt        DateTime?
  lastErrorCode      String?
  lastErrorMessage   String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  transcript  Transcript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)

  @@index([status, runAfter, createdAt])
  @@index([interactionId, createdAt])
  @@index([mediaAssetId, createdAt])
}

model Answer {
  id            String   @id @default(cuid())
  responseId    String
  questionId    String
  categoryId    String?
  value         String
  score         Decimal? @db.Decimal(5, 2)
  comment       String?
  isFatalFail   Boolean  @default(false)
  notApplicable Boolean  @default(false)

  response Response    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])
  category QACategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([categoryId])
}

// ─── Performance Management ──────────────────────────

model CoachingSession {
  id                   String         @id @default(cuid())
  campaignId           String
  agentId              String
  coachId              String
  createdById          String
  responseId           String?
  interactionId        String?
  pipPlanId            String?
  title                String
  focusArea            String
  behavior             String?
  objective            String         @db.Text
  strengths            String?        @db.Text
  opportunities        String?        @db.Text
  rootCause            String?        @db.Text
  comments             String?        @db.Text
  source               CoachingSource @default(MANUAL)
  status               CoachingStatus @default(DRAFT)
  scheduledAt          DateTime?
  acknowledgementDueAt DateTime?
  followUpAt           DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  campaign        Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  agent           Agent                    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  coach           User                     @relation("CoachingCoach", fields: [coachId], references: [id], onDelete: Restrict)
  createdBy       User                     @relation("CoachingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  response        Response?                @relation(fields: [responseId], references: [id], onDelete: SetNull)
  interaction     Interaction?             @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  pipPlan         PipPlan?                 @relation(fields: [pipPlanId], references: [id], onDelete: SetNull)
  actionItems     CoachingActionItem[]
  acknowledgement CoachingAcknowledgement?
  activities      QaActivitySession[]
  evidence        PerformanceEvidence[]

  @@index([campaignId, status, createdAt])
  @@index([agentId, status, createdAt])
  @@index([coachId, status, createdAt])
  @@index([responseId])
  @@index([interactionId])
  @@index([pipPlanId])
}

model CoachingActionItem {
  id                String               @id @default(cuid())
  coachingSessionId String
  description       String               @db.Text
  ownerType         String               @default("AGENT")
  ownerName         String?
  dueAt             DateTime?
  status            CoachingActionStatus @default(OPEN)
  completedAt       DateTime?
  evidenceNote      String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  coachingSession CoachingSession @relation(fields: [coachingSessionId], references: [id], onDelete: Cascade)

  @@index([coachingSessionId, status, dueAt])
}

model CoachingAcknowledgement {
  id                String                 @id @default(cuid())
  coachingSessionId String                 @unique
  status            AcknowledgementStatus  @default(PENDING)
  method            AcknowledgementMethod?
  agentNameSnapshot String
  comment           String?                @db.Text
  acknowledgedAt    DateTime?
  refusedAt         DateTime?
  witnessUserId     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  coachingSession CoachingSession @relation(fields: [coachingSessionId], references: [id], onDelete: Cascade)
  witness         User?           @relation("CoachingAcknowledgementWitness", fields: [witnessUserId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([witnessUserId])
}

model QaActivitySession {
  id                String           @id @default(cuid())
  userId            String
  campaignId        String
  responseId        String?
  coachingSessionId String?
  pipPlanId         String?
  activityType      QaActivityType
  status            QaActivityStatus @default(ACTIVE)
  label             String?
  notes             String?          @db.Text
  startedAt         DateTime         @default(now())
  endedAt           DateTime?
  totalSeconds      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  response        Response?            @relation(fields: [responseId], references: [id], onDelete: SetNull)
  coachingSession CoachingSession?     @relation(fields: [coachingSessionId], references: [id], onDelete: SetNull)
  pipPlan         PipPlan?             @relation(fields: [pipPlanId], references: [id], onDelete: SetNull)
  intervals       QaActivityInterval[]

  @@index([userId, status, startedAt])
  @@index([campaignId, startedAt])
  @@index([responseId])
  @@index([coachingSessionId])
  @@index([pipPlanId])
}

model QaActivityInterval {
  id                String    @id @default(cuid())
  activitySessionId String
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  durationSeconds   Int       @default(0)
  stopReason        String?
  createdAt         DateTime  @default(now())

  activitySession QaActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)

  @@index([activitySessionId, startedAt])
}

model PipPlan {
  id                       String                 @id @default(cuid())
  campaignId               String
  agentId                  String
  ownerId                  String
  createdById              String
  approvedById             String?
  acknowledgementWitnessId String?
  title                    String
  templateKey              String
  templateVersion          String
  reason                   String                 @db.Text
  objective                String                 @db.Text
  baselineSummary          String?                @db.Text
  supportSummary           String?                @db.Text
  consequences             String?                @db.Text
  employeeComments         String?                @db.Text
  reviewFrequency          String?
  startDate                DateTime
  targetEndDate            DateTime
  midpointDate             DateTime?
  finalReviewDate          DateTime?
  status                   PipStatus              @default(DRAFT)
  approvedAt               DateTime?
  acknowledgementStatus    AcknowledgementStatus  @default(PENDING)
  acknowledgementMethod    AcknowledgementMethod?
  acknowledgementComment   String?                @db.Text
  acknowledgedAt           DateTime?
  refusedAt                DateTime?
  outcome                  String?
  closureSummary           String?                @db.Text
  closedAt                 DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  campaign               Campaign              @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  agent                  Agent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  owner                  User                  @relation("PipOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy              User                  @relation("PipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy             User?                 @relation("PipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  acknowledgementWitness User?                 @relation("PipAcknowledgementWitness", fields: [acknowledgementWitnessId], references: [id], onDelete: SetNull)
  goals                  PipGoal[]
  reviews                PipReview[]
  coachingSessions       CoachingSession[]
  activities             QaActivitySession[]
  evidence               PerformanceEvidence[]

  @@index([campaignId, status, createdAt])
  @@index([agentId, status, createdAt])
  @@index([ownerId, status])
  @@index([approvedById])
  @@index([acknowledgementWitnessId])
}

model PipGoal {
  id                   String        @id @default(cuid())
  pipPlanId            String
  area                 String
  baseline             String        @db.Text
  target               String        @db.Text
  measurementPeriod    String?
  dataSource           String
  measurementMethod    String?       @db.Text
  sustainabilityPeriod String?
  isCritical           Boolean       @default(false)
  currentResult        String?       @db.Text
  status               PipGoalStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  pipPlan PipPlan @relation(fields: [pipPlanId], references: [id], onDelete: Cascade)

  @@index([pipPlanId, status])
}

model PipReview {
  id              String            @id @default(cuid())
  pipPlanId       String
  reviewerId      String
  scheduledAt     DateTime
  completedAt     DateTime?
  outcome         PipReviewOutcome?
  summary         String?           @db.Text
  metricsSnapshot Json?
  barriers        String?           @db.Text
  supportProvided String?           @db.Text
  nextSteps       String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  pipPlan  PipPlan @relation(fields: [pipPlanId], references: [id], onDelete: Cascade)
  reviewer User    @relation("PipReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([pipPlanId, scheduledAt])
  @@index([reviewerId, scheduledAt])
}

model PerformanceEvidence {
  id                String                  @id @default(cuid())
  campaignId        String
  coachingSessionId String?
  pipPlanId         String?
  responseId        String?
  interactionId     String?
  createdById       String
  type              PerformanceEvidenceType
  title             String
  description       String?                 @db.Text
  startMs           Int?
  endMs             Int?
  createdAt         DateTime                @default(now())

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  coachingSession CoachingSession? @relation(fields: [coachingSessionId], references: [id], onDelete: Cascade)
  pipPlan         PipPlan?         @relation(fields: [pipPlanId], references: [id], onDelete: Cascade)
  response        Response?        @relation(fields: [responseId], references: [id], onDelete: SetNull)
  interaction     Interaction?     @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("PerformanceEvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
  @@index([coachingSessionId, createdAt])
  @@index([pipPlanId, createdAt])
  @@index([responseId])
  @@index([interactionId])
  @@index([createdById])
}

// ─── Configuración global ──────────────────────────────

/// Clave/valor JSON para settings globales del sistema (umbrales, targets, etc.)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model CampaignScoringSettings {
  id                   String   @id @default(cuid())
  campaignId           String   @unique
  usesGlobalDefaults   Boolean  @default(true)
  passThreshold        Int      @default(70)
  targetPassRate       Int      @default(85)
  targetAvgScore       Int      @default(80)
  targetDailyRate      Int      @default(20)
  fatalFailuresAllowed Int      @default(0)
  // When a critical/fatal question fails: true → force score to 0; false → keep computed score, mark FAIL.
  fatalZeroesScore     Boolean  @default(false)
  // COPC 2.7.1.d — per-campaign Critical Error Accuracy targets (%), one per critical family.
  customerCeaTarget    Float    @default(95)
  businessCeaTarget    Float    @default(90)
  complianceCeaTarget  Float    @default(99.5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedBy            String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  campaignId  String?
  module      String
  action      String
  entityType  String?
  entityId    String?
  beforeValue Json?
  afterValue  Json?
  impact      String?
  createdAt   DateTime @default(now())

  user     User?     @relation("AuditActor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
  @@index([module, action, entityType, createdAt])
  @@index([entityType, entityId])
}

model LoginRateLimit {
  keyHash             String                      @id @db.VarChar(64)
  scope               String                      @db.VarChar(16)
  failureCount        Int                         @default(0)
  windowStartedAt     DateTime
  lastFailureAt       DateTime
  blockedUntil        DateTime?
  expiresAt           DateTime
  updatedAt           DateTime                    @updatedAt
  accountReservations LoginRateLimitReservation[] @relation("AccountLoginReservations")
  ipReservations      LoginRateLimitReservation[] @relation("IpLoginReservations")

  @@index([blockedUntil])
  @@index([expiresAt])
}

model LoginRateLimitReservation {
  id             String   @id @default(uuid()) @db.Uuid
  accountKeyHash String   @db.VarChar(64)
  ipKeyHash      String   @db.VarChar(64)
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  accountLimiter LoginRateLimit @relation("AccountLoginReservations", fields: [accountKeyHash], references: [keyHash], onDelete: Cascade)
  ipLimiter      LoginRateLimit @relation("IpLoginReservations", fields: [ipKeyHash], references: [keyHash], onDelete: Cascade)

  @@index([accountKeyHash, expiresAt])
  @@index([ipKeyHash, expiresAt])
  @@index([expiresAt])
}
