generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum Role {
  ADMIN
  QA
  SUPERVISOR
}

enum CampaignAccessLevel {
  CAMPAIGN_ADMIN
  EVALUATOR
  SUPERVISOR
}

enum QuestionType {
  TEXT
  RATING
  SELECT
  RADIO
  BOOLEAN
}

// COPC critical-error classification (2.7.1.d). A question flagged `fatal`
// may carry one of these so failures roll up into per-class critical accuracy.
enum CriticalType {
  CUSTOMER
  BUSINESS
  COMPLIANCE
}

// Machine-readable call outcome, so KPIs (FCR, escalation rate) stop relying
// on disposition name-matching. One outcome per call.
enum DispositionOutcome {
  RESOLVED
  ESCALATED
  TRANSFERRED
  FOLLOW_UP
  CALLBACK
  SALE
  NO_SALE
  NO_CONTACT
  DNC
  SYSTEM
  OTHER
}

// ─── Auth.js required models ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Usuarios y campañas ─────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  password       String?
  role           Role      @default(QA)
  active         Boolean   @default(true)
  sessionVersion Int       @default(0)
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  campaigns               UserCampaign[]
  forms                   Form[]                   @relation("FormCreator")
  responses               Response[]               @relation("Evaluator")
  dispositionsCreated     Disposition[]            @relation("DispositionCreator")
  auditLogs               AuditLog[]               @relation("AuditActor")
  notifications           Notification[]           @relation("UserNotifications")
  notificationPreferences NotificationPreference[]
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 UserCampaign[]
  forms                 Form[]
  agents                Agent[]
  teams                 Team[]
  dispositionCategories DispositionCategory[]
  dispositions          Disposition[]
  auditLogs             AuditLog[]
  scoringSettings       CampaignScoringSettings?
  notifications         Notification[]
}

model UserCampaign {
  userId                   String
  campaignId               String
  assignedAt               DateTime            @default(now())
  roleInCampaign           CampaignAccessLevel @default(EVALUATOR)
  canViewDashboard         Boolean             @default(true)
  canViewKPIs              Boolean             @default(false)
  canViewForms             Boolean             @default(true)
  canCreateForms           Boolean             @default(false)
  canEditForms             Boolean             @default(false)
  canPublishForms          Boolean             @default(false)
  canEvaluate              Boolean             @default(true)
  canEditEvaluations       Boolean             @default(false)
  canViewReports           Boolean             @default(false)
  canExport                Boolean             @default(false)
  canManageAgents          Boolean             @default(false)
  canManageDispositions    Boolean             @default(false)
  canManageCampaignScoring Boolean             @default(false)
  canViewAudit             Boolean             @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([userId, campaignId])
  @@index([campaignId])
}

// ─── Equipos ─────────────────────────────────────────

model Team {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agents   Agent[]

  @@unique([name, campaignId])
}

// ─── Disposiciones ───────────────────────────────────

model DispositionCategory {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dispositions Disposition[]

  @@unique([name, campaignId])
}

model Disposition {
  id          String              @id @default(cuid())
  name        String
  code        String?
  categoryId  String?
  campaignId  String
  active      Boolean             @default(true)
  outcomeType DispositionOutcome?
  isSystem    Boolean             @default(false)
  createdById String?
  createdAt   DateTime            @default(now())

  category  DispositionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaign  Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("DispositionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responses Response[]

  @@unique([name, campaignId])
  @@index([campaignId, active])
}

// ─── Agentes (no inician sesión) ─────────────────────

model Agent {
  id         String   @id @default(cuid())
  name       String
  agentCode  String?
  campaignId String
  teamId     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  responses Response[]

  @@unique([agentCode, campaignId])
}

// ─── Formularios ─────────────────────────────────────

model Form {
  id           String    @id @default(cuid())
  title        String
  description  String?
  campaignId   String
  createdById  String
  parentFormId String?
  status       String    @default("DRAFT")
  version      String    @default("1.0.0")
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign   Campaign       @relation(fields: [campaignId], references: [id])
  createdBy  User           @relation("FormCreator", fields: [createdById], references: [id])
  parent     Form?          @relation("FormRevisions", fields: [parentFormId], references: [id], onDelete: SetNull)
  revisions  Form[]         @relation("FormRevisions")
  categories FormCategory[]
  questions  Question[]
  responses  Response[]

  @@index([parentFormId])
  @@index([status])
}

model Question {
  id                    String        @id @default(cuid())
  formId                String
  formCategoryId        String?
  type                  QuestionType
  label                 String
  options               Json?
  required              Boolean       @default(false)
  weight                Int           @default(0)
  fatal                 Boolean       @default(false)
  fatalOptions          Json?
  criticalType          CriticalType?
  // For a `fatal` RATING: fails when value < ratingFailThreshold. Null → default (3, i.e. <=2 on 1-5).
  ratingFailThreshold   Int?
  // Configurable rating scale. ratingMax null → 5; ratingStyle null → "numeric" (vs "stars").
  ratingMax             Int?
  ratingStyle           String?
  requiresCommentOnFail Boolean       @default(false)
  order                 Int           @default(0)

  form         Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  formCategory FormCategory? @relation(fields: [formCategoryId], references: [id], onDelete: SetNull)
  answers      Answer[]

  @@index([formId, order])
  @@index([formCategoryId])
}

model QACategory {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  systemColor           String?
  systemIcon            String?
  isActive              Boolean  @default(true)
  canBeFatal            Boolean  @default(false)
  requiresCommentOnFail Boolean  @default(false)
  visibleInDashboard    Boolean  @default(true)
  visibleInKPIs         Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  formCategories FormCategory[]
  answers        Answer[]
}

model FormCategory {
  id              String  @id @default(cuid())
  formId          String
  qaCategoryId    String
  weight          Int     @default(0)
  fatalIfFailed   Boolean @default(false)
  requiresComment Boolean @default(false)
  sortOrder       Int     @default(0)

  form       Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  qaCategory QACategory @relation(fields: [qaCategoryId], references: [id], onDelete: Restrict)
  questions  Question[]

  @@unique([formId, qaCategoryId])
  @@index([qaCategoryId])
  @@index([formId, sortOrder])
}

// ─── Evaluaciones ────────────────────────────────────

model Response {
  id                 String    @id @default(cuid())
  formId             String
  formVersion        String?
  agentId            String
  evaluatorId        String
  dispositionId      String?
  score              Decimal   @db.Decimal(5, 2)
  result             String?
  hasFatalFail       Boolean   @default(false)
  status             String    @default("SUBMITTED")
  scoringSnapshot    Json?
  settingsSnapshot   Json?
  formSnapshot       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  submittedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  form        Form         @relation(fields: [formId], references: [id])
  agent       Agent        @relation(fields: [agentId], references: [id])
  evaluator   User         @relation("Evaluator", fields: [evaluatorId], references: [id])
  disposition Disposition? @relation(fields: [dispositionId], references: [id])
  answers     Answer[]

  @@index([formId, createdAt])
  @@index([agentId])
  @@index([evaluatorId])
  @@index([dispositionId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([cancelledById])
}

model Answer {
  id            String   @id @default(cuid())
  responseId    String
  questionId    String
  categoryId    String?
  value         String
  score         Decimal? @db.Decimal(5, 2)
  comment       String?
  isFatalFail   Boolean  @default(false)
  notApplicable Boolean  @default(false)

  response Response    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])
  category QACategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([categoryId])
}

// ─── Configuración global ──────────────────────────────

/// Clave/valor JSON para settings globales del sistema (umbrales, targets, etc.)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model CampaignScoringSettings {
  id                   String   @id @default(cuid())
  campaignId           String   @unique
  usesGlobalDefaults   Boolean  @default(true)
  passThreshold        Int      @default(70)
  targetPassRate       Int      @default(85)
  targetAvgScore       Int      @default(80)
  targetDailyRate      Int      @default(20)
  fatalFailuresAllowed Int      @default(0)
  // When a critical/fatal question fails: true → force score to 0; false → keep computed score, mark FAIL.
  fatalZeroesScore     Boolean  @default(false)
  // COPC 2.7.1.d — per-campaign Critical Error Accuracy targets (%), one per critical family.
  customerCeaTarget    Float    @default(95)
  businessCeaTarget    Float    @default(90)
  complianceCeaTarget  Float    @default(99.5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedBy            String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  campaignId  String?
  module      String
  action      String
  entityType  String?
  entityId    String?
  beforeValue Json?
  afterValue  Json?
  impact      String?
  createdAt   DateTime @default(now())

  user     User?     @relation("AuditActor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
  @@index([module, action, entityType, createdAt])
  @@index([entityType, entityId])
}

model LoginRateLimit {
  keyHash             String                      @id @db.VarChar(64)
  scope               String                      @db.VarChar(16)
  failureCount        Int                         @default(0)
  windowStartedAt     DateTime
  lastFailureAt       DateTime
  blockedUntil        DateTime?
  expiresAt           DateTime
  updatedAt           DateTime                    @updatedAt
  accountReservations LoginRateLimitReservation[] @relation("AccountLoginReservations")
  ipReservations      LoginRateLimitReservation[] @relation("IpLoginReservations")

  @@index([blockedUntil])
  @@index([expiresAt])
}

model LoginRateLimitReservation {
  id             String   @id @default(uuid()) @db.Uuid
  accountKeyHash String   @db.VarChar(64)
  ipKeyHash      String   @db.VarChar(64)
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  accountLimiter LoginRateLimit @relation("AccountLoginReservations", fields: [accountKeyHash], references: [keyHash], onDelete: Cascade)
  ipLimiter      LoginRateLimit @relation("IpLoginReservations", fields: [ipKeyHash], references: [keyHash], onDelete: Cascade)

  @@index([accountKeyHash, expiresAt])
  @@index([ipKeyHash, expiresAt])
  @@index([expiresAt])
}

model Notification {
  id                 String    @id @default(cuid())
  userId             String
  campaignId         String?
  type               String
  severity           String    @default("INFO")
  title              String
  body               String
  href               String?
  entityType         String?
  entityId           String?
  requiredPermission String?
  metadata           Json?
  readAt             DateTime?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())

  user     User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([campaignId, createdAt])
  @@index([userId, campaignId, requiredPermission])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model NotificationPreference {
  userId    String
  type      String
  inApp     Boolean  @default(true)
  email     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@index([type])
}
