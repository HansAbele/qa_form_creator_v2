generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum Role {
  ADMIN
  QA
}

enum CampaignAccessLevel {
  CAMPAIGN_ADMIN
  EVALUATOR
  SUPERVISOR
}

enum QuestionType {
  TEXT
  RATING
  SELECT
  RADIO
}

// ─── Auth.js required models ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Usuarios y campañas ─────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  role      Role     @default(QA)
  active    Boolean  @default(true)
  image     String?
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  campaigns            UserCampaign[]
  forms                Form[]         @relation("FormCreator")
  responses            Response[]     @relation("Evaluator")
  dispositionsCreated  Disposition[]  @relation("DispositionCreator")
  auditLogs            AuditLog[]     @relation("AuditActor")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 UserCampaign[]
  forms                 Form[]
  agents                Agent[]
  teams                 Team[]
  dispositionCategories DispositionCategory[]
  dispositions          Disposition[]
  auditLogs             AuditLog[]
  scoringSettings       CampaignScoringSettings?
}

model UserCampaign {
  userId                   String
  campaignId               String
  assignedAt               DateTime            @default(now())
  roleInCampaign           CampaignAccessLevel @default(CAMPAIGN_ADMIN)
  canViewDashboard         Boolean             @default(true)
  canViewKPIs              Boolean             @default(true)
  canViewForms             Boolean             @default(true)
  canCreateForms           Boolean             @default(true)
  canEditForms             Boolean             @default(true)
  canPublishForms          Boolean             @default(true)
  canEvaluate              Boolean             @default(true)
  canEditEvaluations       Boolean             @default(true)
  canViewReports           Boolean             @default(true)
  canExport                Boolean             @default(true)
  canManageAgents          Boolean             @default(true)
  canManageDispositions    Boolean             @default(true)
  canManageCampaignScoring Boolean             @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([userId, campaignId])
  @@index([campaignId])
}

// ─── Equipos ─────────────────────────────────────────

model Team {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agents   Agent[]

  @@unique([name, campaignId])
}

// ─── Disposiciones ───────────────────────────────────

model DispositionCategory {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dispositions Disposition[]

  @@unique([name, campaignId])
}

model Disposition {
  id          String   @id @default(cuid())
  name        String
  code        String?
  categoryId  String?
  campaignId  String
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  category  DispositionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaign  Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("DispositionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responses Response[]

  @@unique([name, campaignId])
  @@index([campaignId, active])
}

// ─── Agentes (no inician sesión) ─────────────────────

model Agent {
  id         String   @id @default(cuid())
  name       String
  agentCode  String?
  campaignId String
  teamId     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  responses Response[]

  @@unique([agentCode, campaignId])
}

// ─── Formularios ─────────────────────────────────────

model Form {
  id          String   @id @default(cuid())
  title       String
  description String?
  campaignId  String
  createdById String
  status      String   @default("DRAFT")
  version     String   @default("1.0.0")
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id])
  createdBy User       @relation("FormCreator", fields: [createdById], references: [id])
  categories FormCategory[]
  questions Question[]
  responses Response[]
}

model Question {
  id                    String       @id @default(cuid())
  formId                String
  formCategoryId        String?
  type                  QuestionType
  label                 String
  options               Json?
  required              Boolean      @default(false)
  weight                Int          @default(0)
  fatal                 Boolean      @default(false)
  requiresCommentOnFail Boolean      @default(false)
  order                 Int          @default(0)

  form         Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  formCategory FormCategory? @relation(fields: [formCategoryId], references: [id], onDelete: SetNull)
  answers      Answer[]

  @@index([formId, order])
  @@index([formCategoryId])
}

model QACategory {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  systemColor           String?
  systemIcon            String?
  isActive              Boolean  @default(true)
  canBeFatal            Boolean  @default(false)
  requiresCommentOnFail Boolean  @default(false)
  visibleInDashboard    Boolean  @default(true)
  visibleInKPIs         Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  formCategories FormCategory[]
  answers        Answer[]
}

model FormCategory {
  id              String  @id @default(cuid())
  formId          String
  qaCategoryId    String
  weight          Int     @default(0)
  fatalIfFailed   Boolean @default(false)
  requiresComment Boolean @default(false)
  sortOrder       Int     @default(0)

  form       Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  qaCategory QACategory @relation(fields: [qaCategoryId], references: [id], onDelete: Restrict)
  questions  Question[]

  @@unique([formId, qaCategoryId])
  @@index([qaCategoryId])
  @@index([formId, sortOrder])
}

// ─── Evaluaciones ────────────────────────────────────

model Response {
  id            String   @id @default(cuid())
  formId        String
  formVersion   String?
  agentId       String
  evaluatorId   String
  dispositionId String?
  score         Decimal  @db.Decimal(5, 2)
  result        String?
  hasFatalFail  Boolean  @default(false)
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())

  form        Form         @relation(fields: [formId], references: [id])
  agent       Agent        @relation(fields: [agentId], references: [id])
  evaluator   User         @relation("Evaluator", fields: [evaluatorId], references: [id])
  disposition Disposition? @relation(fields: [dispositionId], references: [id])
  answers     Answer[]

  @@index([formId, createdAt])
  @@index([agentId])
  @@index([evaluatorId])
  @@index([dispositionId])
  @@index([createdAt])
}

model Answer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  categoryId String?
  value      String
  score      Decimal? @db.Decimal(5, 2)
  comment    String?
  isFatalFail Boolean @default(false)

  response Response    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])
  category QACategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([categoryId])
}

// ─── Configuración global ──────────────────────────────

/// Clave/valor JSON para settings globales del sistema (umbrales, targets, etc.)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model CampaignScoringSettings {
  id                   String   @id @default(cuid())
  campaignId           String   @unique
  usesGlobalDefaults   Boolean  @default(true)
  passThreshold        Int      @default(70)
  targetPassRate       Int      @default(85)
  targetAvgScore       Int      @default(80)
  targetDailyRate      Int      @default(20)
  fatalFailuresAllowed Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedBy            String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  campaignId  String?
  module      String
  action      String
  entityType  String?
  entityId    String?
  beforeValue Json?
  afterValue  Json?
  impact      String?
  createdAt   DateTime @default(now())

  user     User?     @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
  @@index([module, action])
  @@index([entityType, entityId])
}
