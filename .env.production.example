# ─── Database ─────────────────────────
DB_OWNER_USER=qa_owner
DB_OWNER_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
DB_APP_USER=qa_app
DB_APP_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ─── Auth.js ──────────────────────────
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
RATE_LIMIT_HASH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
AUTH_URL=https://CHANGE_ME.example

# ─── Logging ──────────────────────────
LOG_LEVEL=info
# Zona IANA comun a todas las replicas; cambiarla reagrupa fechas historicas.
OPERATIONAL_TIME_ZONE=UTC
# Docker monta un volumen persistente privado en esta ruta.
RECORDING_STORAGE_ROOT=/var/lib/qore/recordings
MAX_RECORDING_BYTES=262144000
# Inyectar desde el gestor de secretos; HAPUSA recupera archivos ACD legacy.
NICE_CXONE_TOKEN_URL=
NICE_CXONE_ACCESS_KEY_ID=
NICE_CXONE_ACCESS_KEY_SECRET=
NICE_CXONE_API_BASE_URL=
NICE_CXONE_RECORDING_MODE=legacy-acd
NICE_CXONE_ADMIN_API_VERSION=v34.0
NICE_CXONE_MEDIA_BASE_URL=
NICE_CXONE_INSTANCE_KEY=hapusa
NICE_CXONE_SCOPE_FIELD=campaign
NICE_CXONE_PAGE_SIZE=1000
NICE_CXONE_MAX_LEGACY_RECORDING_BYTES=104857600
# Claves de transcripción inyectadas desde el gestor de secretos del servidor.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEY_II=
NVIDIA_NIM_TRANSCRIPTION_URL=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com/v1/audio/transcriptions
NVIDIA_NIM_TRANSCRIPTION_MODEL=parakeet-ctc-1.1b-asr
GROQ_API_KEY=
GROQ_API_KEY_II=
GROQ_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Deepgram separa hablantes en las grabaciones mono entregadas por NICE.
DEEPGRAM_API_KEY=
DEEPGRAM_API_KEY_II=
DEEPGRAM_TRANSCRIPTION_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
TRANSCRIPTION_PROVIDER_ORDER=DEEPGRAM,NVIDIA_NIM,GROQ
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_REQUEST_TIMEOUT_MS=300000
TRANSCRIPTION_MAX_AUDIO_BYTES=25165824
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCRIPTION_WORKER_ENABLED=true
TRANSCRIPTION_WORKER_POLL_MS=5000
TRANSCRIPTION_JOB_MAX_ATTEMPTS=3
TRANSCRIPTION_JOB_LEASE_MS=2700000
# Limites de seguridad de exportacion; no son objetivos de capacidad.
EXPORT_MAX_EVALUATIONS=1000
EXPORT_MAX_ANSWER_ROWS=10000
EXPORT_MAX_QUESTION_COLUMNS=100
EXPORT_MAX_CELLS=100000
EXPORT_MAX_TEXT_BYTES=8000000
EXPORT_MAX_REQUESTS_PER_MINUTE=4
EXPORT_MAX_CONCURRENT_PER_USER=1
EXPORT_MAX_CONCURRENT_GLOBAL=2
EXPORT_LEASE_TIMEOUT_SECONDS=900
# Receptor HTTPS de eventos JSON autenticados con Authorization: Bearer.
OBSERVABILITY_SERVICE_NAME=qore-production
ERROR_REPORTING_WEBHOOK_URL=https://CHANGE_ME.example/qore-errors
ERROR_REPORTING_WEBHOOK_TOKEN=CHANGE_ME_PROVIDER_BEARER_TOKEN

# ─── Encrypted, off-site backups ─────────────────────
BACKUP_ENCRYPTION_KEY_FILE=/opt/qa-form-creator/.backup-key
BACKUP_REMOTE=CHANGE_ME_RCLONE_REMOTE:qore-production
REQUIRE_OFFSITE_BACKUP=true
RETENTION_DAYS=30
MIN_FREE_DISK_MB=2048

# El deploy falla cerrado hasta que el ticket de incidente contenga evidencia
# de rotacion/revocacion y de saneamiento de todas las referencias Git remotas.
SECRET_ROTATION_CONFIRMED=false
SECRET_HISTORY_REMEDIATED=false

# Solo se cambia a true una vez, y únicamente si PostgreSQL demuestra que la
# base no contiene tablas. Los upgrades siempre deben dejarlo en false.
INITIAL_DEPLOY=false

# El seed de datos de muestra esta deshabilitado en produccion.
# Los importadores remotos requieren ambos opt-ins y una credencial fuerte
# suministrada por el gestor de secretos; se mantienen apagados por defecto.
QORE_ALLOW_REMOTE_IMPORT=false
QORE_ALLOW_PRODUCTION_IMPORT=false
QORE_ALLOW_ADMIN_IMPORT=false
